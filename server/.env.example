# DokitaAI Environment Variables Configuration Template

# Node Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dokita_ai?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_2026

# Admin Registration Secret Key
ADMIN_SECRET_KEY=your_admin_registration_key

# Primary AI Model Provider: "gemini" or "openai"
AI_PROVIDER=gemini

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Configuration (Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Meta / WhatsApp Business Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=dokita_whatsapp_verify_token_2026
